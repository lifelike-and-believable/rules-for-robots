{
  "description": "rfr-unreal hooks: refuse an Unreal editor run whose -ExecCmds list does not end with Quit (#56).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-unreal.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
