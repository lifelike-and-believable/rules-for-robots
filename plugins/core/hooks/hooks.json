{
  "description": "rfr-core default hooks: ask before destructive commands (WA-003) and edits to existing tests (TEST-001); format edited files with the project's own formatter.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-commands.mjs\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-test-edits.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/format-on-edit.mjs\"", "timeout": 30 }
        ]
      }
    ]
  }
}
