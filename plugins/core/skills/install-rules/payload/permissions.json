{
  "allow": [
    "Bash(git status *)",
    "PowerShell(git status *)",
    "Bash(git diff *)",
    "PowerShell(git diff *)",
    "Bash(git log *)",
    "PowerShell(git log *)",
    "Bash(git show *)",
    "PowerShell(git show *)",
    "Bash(git fetch *)",
    "PowerShell(git fetch *)",
    "Bash(git add *)",
    "PowerShell(git add *)",
    "Bash(git commit *)",
    "PowerShell(git commit *)",
    "Bash(git switch *)",
    "PowerShell(git switch *)",
    "WebSearch"
  ],
  "deny": [
    "Read(./.env)",
    "Read(./.env.*)",
    "Read(./**/*.pem)"
  ]
}
