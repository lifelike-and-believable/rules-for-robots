{
  "allow": [
    "Bash(git status *)",
    "PowerShell(git status *)",
    "Bash(git diff *)",
    "PowerShell(git diff *)",
    "Bash(git log *)",
    "PowerShell(git log *)",
    "Bash(git show *)",
    "PowerShell(git show *)",
    "Bash(git fetch *)",
    "PowerShell(git fetch *)",
    "Bash(git add *)",
    "PowerShell(git add *)",
    "Bash(git commit *)",
    "PowerShell(git commit *)",
    "Bash(git switch *)",
    "PowerShell(git switch *)",
    "WebSearch"
  ],
  "deny": [
    "Bash(git push --force *)",
    "PowerShell(git push --force *)",
    "Bash(git push -f *)",
    "PowerShell(git push -f *)",
    "Bash(git push origin main)",
    "PowerShell(git push origin main)",
    "Bash(git push origin master)",
    "PowerShell(git push origin master)",
    "Bash(git push --delete *)",
    "PowerShell(git push --delete *)",
    "Bash(git push origin --delete *)",
    "PowerShell(git push origin --delete *)",
    "Bash(gh repo delete *)",
    "PowerShell(gh repo delete *)",
    "Bash(vercel --prod *)",
    "PowerShell(vercel --prod *)",
    "Bash(vercel deploy --prod *)",
    "PowerShell(vercel deploy --prod *)",
    "Read(./.env)",
    "Read(./.env.*)",
    "Read(./**/*.pem)"
  ]
}
