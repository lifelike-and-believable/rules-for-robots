#!/usr/bin/env node
// Fake gh for the merge-when-green smoke tests. Reads the scenario from .git/fake-gh.json in
// the current repository, logs every call to .git/gh-calls.log, and answers the pull request
// commands the skill uses: pr checks (with or without --watch), pr view --json, pr merge,
// run view --log-failed, and run list.
import { spawnSync } from 'node:child_process';
import fs from 'node:fs';
import path from 'node:path';

const args = process.argv.slice(2);
const git = path.join(process.cwd(), '.git');
try { fs.appendFileSync(path.join(git, 'gh-calls.log'), JSON.stringify(args) + '\n'); } catch {}
let s;
try { s = JSON.parse(fs.readFileSync(path.join(git, 'fake-gh.json'), 'utf8')); } catch { console.error('fake gh: no scenario'); process.exit(1); }

// A scenario with pendingUntilWatch shows its checks as running until `pr checks --watch` has been called.
const pending = !!s.pendingUntilWatch && !s.watched;
const checks = s.checks.map(c => ({ name: c.name, state: pending ? 'PENDING' : c.conclusion, bucket: pending ? 'pending' : c.conclusion === 'SUCCESS' ? 'pass' : 'fail', link: `https://ci.example/run/${s.runId}` }));
const rollup = s.checks.map(c => ({ __typename: 'CheckRun', name: c.name, status: pending ? 'IN_PROGRESS' : 'COMPLETED', conclusion: pending ? '' : c.conclusion, detailsUrl: `https://ci.example/run/${s.runId}` }));
const pr = {
  number: s.number, title: s.title, state: s.merged ? 'MERGED' : 'OPEN', headRefName: s.branch, baseRefName: 'main', headRefOid: s.head,
  mergeStateStatus: pending ? 'BLOCKED' : s.checks.every(c => c.conclusion === 'SUCCESS') ? 'CLEAN' : 'UNSTABLE', reviewDecision: '', mergeable: 'MERGEABLE',
  statusCheckRollup: rollup, url: `https://github.example/acme/app/pull/${s.number}`,
};
const failing = s.checks.some(c => c.conclusion !== 'SUCCESS');
const [cmd, sub] = args;
const jsonIdx = args.indexOf('--json');
const pick = fields => Object.fromEntries(fields.split(',').map(f => [f, pr[f]]));

if (cmd === 'pr' && sub === 'checks') {
  const watchedNow = args.includes('--watch') && pending;
  if (watchedNow) {
    s.watched = true;
    fs.writeFileSync(path.join(git, 'fake-gh.json'), JSON.stringify(s));
    checks.forEach((c, i) => Object.assign(c, { state: s.checks[i].conclusion, bucket: s.checks[i].conclusion === 'SUCCESS' ? 'pass' : 'fail' }));
  }
  if (jsonIdx !== -1) console.log(JSON.stringify(checks.map(c => ({ name: c.name, state: c.state, bucket: c.bucket, link: c.link }))));
  else for (const c of checks) console.log(`${c.name}\t${c.bucket}\t1m2s\t${c.link}`);
  process.exitCode = pending && !watchedNow ? 8 : failing ? 1 : 0;
} else if (cmd === 'pr' && sub === 'view') {
  if (jsonIdx !== -1) console.log(JSON.stringify(pick(args[jsonIdx + 1])));
  else console.log(`${pr.title} #${pr.number}\n${pr.state} • ${pr.headRefName} into main`);
} else if (cmd === 'repo' && sub === 'view') {
  const settings = { mergeCommitAllowed: true, squashMergeAllowed: true, rebaseMergeAllowed: true, name: 'app', defaultBranchRef: { name: 'main' } };
  console.log(JSON.stringify(jsonIdx !== -1 ? Object.fromEntries(args[jsonIdx + 1].split(',').map(f => [f, settings[f]])) : settings));
} else if (cmd === 'pr' && sub === 'list') {
  console.log(jsonIdx !== -1 ? '[]' : '');
} else if (cmd === 'pr' && sub === 'merge') {
  const match = args.indexOf('--match-head-commit');
  if (match !== -1 && args[match + 1] !== s.head) { console.error('GraphQL: Head branch was modified. Review and try the merge again.'); process.exit(1); }
  if (failing && !args.includes('--admin')) { console.error('X Pull request is not mergeable: the base branch policy prohibits the merge.'); process.exit(1); }
  // Merging fast-forwards the remote's main to the pull request head, as a real merge would.
  spawnSync('git', ['push', '-q', 'origin', `${s.head}:refs/heads/main`]);
  s.merged = true;
  fs.writeFileSync(path.join(git, 'fake-gh.json'), JSON.stringify(s));
  console.log(`✓ Merged pull request #${s.number} (${s.title})`);
} else if (cmd === 'run' && sub === 'view') {
  console.log(args.includes('--log-failed') ? s.failedLog ?? 'no failed jobs' : `✓ ${s.title} · ${s.runId}`);
} else if (cmd === 'run' && sub === 'list') {
  console.log(`${failing ? 'X' : '✓'}  ${s.title}  CI  ${s.branch}  pull_request  ${s.runId}  1m2s`);
} else {
  console.log('gh (fake): command not supported in this environment');
}
