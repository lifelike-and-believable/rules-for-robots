      { oid: 'e2a84c61f9b3d7051c6e8a2f4b9d1c3e5a7f0b86', messageHeadline: 'Quote SKUs that contain commas', committedDate: '2026-10-04T17:05:13Z' },
    ],
    checks: [check('verify', 'SUCCESS', 876, '2026-10-04T17:06:00Z', '2026-10-04T17:08:01Z'), check('lint', 'SUCCESS', 875, '2026-10-04T17:06:00Z', '2026-10-04T17:06:27Z')],
