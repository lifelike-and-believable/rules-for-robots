+import { stock } from './index.js';
+
+// Items at or below the threshold, sorted by quantity.
+export function lowStock(threshold = 5) {
+  const out = [];
+  for (const [sku, quantity] of stock) {
+    if (quantity <= threshold) out.push({ sku, quantity });
+  }
+  return out.sort((a, b) => a.quantity - b.quantity);
+}
`,
  },
