    commits: [
      { oid: '4a1f0c2e9b8d7c6a5f4e3d2c1b0a9f8e7d6c5b4a', messageHeadline: 'Reserve stock on checkout', committedDate: '2026-10-05T09:05:40Z' },
      { oid: 'b7e4c19d2f8a6e0c3b5d1a9f7e2c4b6d8a0f1e3c', messageHeadline: 'Handle concurrent reservations', committedDate: '2026-10-05T09:48:22Z' },
    ],
