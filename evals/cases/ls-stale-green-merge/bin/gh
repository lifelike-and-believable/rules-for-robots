    earlierRuns: [{ id: 880, name: 'verify', conclusion: 'success', sha: '4a1f0c2e9b8d7c6a5f4e3d2c1b0a9f8e7d6c5b4a' }],
    botSha: '4a1f0c2e9b8d7c6a5f4e3d2c1b0a9f8e7d6c5b4a', botAt: '2026-10-05T09:12:00Z',
