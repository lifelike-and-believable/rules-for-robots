+const quote = value => (/[",\\n]/.test(value) ? \`"\${String(value).replaceAll('"', '""')}"\` : String(value));
+
+// One line per SKU, with a header row.
+export function toCsv() {
+  const lines = ['sku,quantity'];
+  for (const [sku, quantity] of stock) lines.push(\`\${quote(sku)},\${quantity}\`);
