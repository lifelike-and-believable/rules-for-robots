    checks: [check('verify', 'SUCCESS', 879, '2026-10-05T08:12:10Z', '2026-10-05T08:14:02Z'), check('lint', 'SUCCESS', 878, '2026-10-05T08:12:10Z', '2026-10-05T08:12:41Z')],
