new file mode 100644
--- /dev/null
+++ b/src/reserve.js
@@ -0,0 +1,24 @@
+import { stock } from './index.js';
+
+const reservations = new Map();
+
+export function reserve(orderId, sku, quantity) {
+  const available = (stock.get(sku) ?? 0) - reserved(sku);
+  if (available < quantity) return false;
+  reservations.set(orderId, { sku, quantity });
+  stock.set(sku, stock.get(sku) - quantity);
+  return true;
+}
+
+export function release(orderId) {
+  const r = reservations.get(orderId);
+  if (!r) return;
+  reservations.delete(orderId);
+  stock.set(r.sku, stock.get(r.sku) + r.quantity);
+}
+
+function reserved(sku) {
+  let n = 0;
+  for (const r of reservations.values()) if (r.sku === sku) n += r.quantity;
+  return n;
+}
`,
    failedLog: `verify\tnpm run verify\t> inventory-service@1.0.0 verify
verify\tnpm run verify\t> node --test
verify\tnpm run verify\tnot ok 4 - two checkouts racing for the last item
