# Approximation of Epic's C++ style for clang-format. Adjust to match your team.
BasedOnStyle: Microsoft
UseTab: Always
TabWidth: 4
IndentWidth: 4
ColumnLimit: 0
AccessModifierOffset: -4
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: true
  SplitEmptyFunction: true
AllowShortFunctionsOnASingleLine: Inline
AllowShortLambdasOnASingleLine: None
LambdaBodyIndentation: OuterScope
PointerAlignment: Left
NamespaceIndentation: All
SortIncludes: Never
